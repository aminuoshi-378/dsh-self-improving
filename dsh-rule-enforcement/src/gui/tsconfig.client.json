{
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "moduleDetection": "force",
    "noEmit": false,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "rootDir": ".",
    "outDir": "lib/types"
  },
  "include": ["index.ts", "client/**/*.ts", "client/**/*.tsx"]
}