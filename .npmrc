# prebuild-install 二进制镜像（better-sqlite3 等原生模块）
# 默认从 GitHub releases 下载预编译，国内网络常 ECONNRESET，改走 npmmirror 镜像
better_sqlite3_binary_host=https://registry.npmmirror.com/-/binary

# 包管理器 registry 镜像
# registry=https://mirrors.cloud.tencent.com/npm/

# 跳过 pnpm run 前的依赖状态检查
# @deepseek-ai/* 是 dsh 运行时内部包（optional peerDeps），不在公开 npm registry，
# pnpm 自动检查依赖状态会 404 失败，导致 pnpm test / pnpm run build 被阻断
verify-deps-before-run=false