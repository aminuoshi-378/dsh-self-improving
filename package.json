{
  "name": "dsh-self-improving",
  "version": "0.1.0",
  "description": "Self-improving cross-session learning plugin (dsh-plugin) for DeepSeek Harness (dsh) — learns from past experience and injects relevant memories into each new task",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "self-improving", "agent-memory", "learning"],
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "cordis.yml"],
  "scripts": {
    "build": "tsc",
    "test": "tsx test/experience-store.test.ts && tsx test/outcome-evaluator.test.ts && tsx test/behavior-adapter.test.ts && tsx test/meta-cognition.test.ts && tsx test/memory-benchmark.test.ts && tsx test/advanced-features.test.ts && tsx test/adaptive-strategy.test.ts && tsx test/event-parsing.test.ts && tsx test/correction.test.ts",
    "test:store": "tsx test/experience-store.test.ts",
    "test:evaluator": "tsx test/outcome-evaluator.test.ts",
    "test:adapter": "tsx test/behavior-adapter.test.ts",
    "test:meta": "tsx test/meta-cognition.test.ts",
    "test:memory": "tsx test/memory-benchmark.test.ts",
    "test:advanced": "tsx test/advanced-features.test.ts",
    "test:adaptive": "tsx test/adaptive-strategy.test.ts",
    "test:event": "tsx test/event-parsing.test.ts",
    "test:correction": "tsx test/correction.test.ts",
    "benchmark": "tsx benchmark/run-benchmark.ts",
    "pack": "pnpm run build && pnpm pack"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "ulid": "^2.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-agent": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/dsh-session": { "optional": true },
    "@deepseek-ai/dsh-system-prompt": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "devDependencies": {
    "@langchain/core": "^1.2.9",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "agentevals": "^0.0.7",
    "promptfoo": "^0.121.20",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.yml"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
